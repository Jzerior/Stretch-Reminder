<Window x:Class="StretchReminder.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stretch Reminder - Ustawienia"
        Width="840"
        MinWidth="740" MinHeight="550"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#1E293B" />
        <SolidColorBrush x:Key="CardBorder" Color="#334155" />

        <!-- Modern Dark ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
            <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="thumbBorder" Background="#334155" CornerRadius="4" Margin="1,0,1,0" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="true">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#64748B" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="true">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#10B981" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Width" Value="Auto" />
                                    <Setter Property="Height" Value="8" />
                                    <Setter Property="MinHeight" Value="8" />
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="false" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Dark Slider Style -->
            <Style x:Key="ModernSliderThumb" TargetType="{x:Type Thumb}">
                <Setter Property="SnapsToDevicePixels" Value="true" />
                <Setter Property="OverridesDefaultStyle" Value="true" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Grid Width="20" Height="20">
                                <Ellipse x:Name="thumbEllipse" Width="18" Height="18" Fill="#10B981" Stroke="#FFFFFF" StrokeThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.4" Color="#000000" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="thumbEllipse" Property="Fill" Value="#34D399" />
                                    <Setter TargetName="thumbEllipse" Property="Width" Value="20" />
                                    <Setter TargetName="thumbEllipse" Property="Height" Value="20" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="thumbEllipse" Property="Fill" Value="#059669" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type Slider}">
                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#10B981" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Slider}">
                            <Grid VerticalAlignment="Center">
                                <Border Height="6" Background="#334155" CornerRadius="3" VerticalAlignment="Center" Margin="8,0" />
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                    <Border Height="6" Background="#10B981" CornerRadius="3,0,0,3" Margin="8,0,0,0" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ModernSliderThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                    <Border Background="Transparent" Height="6" Margin="0,0,8,0" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#10B981" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#334155" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#475569" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#059669" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🏃" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Stretch Reminder" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Przypominacz o aktywności i zdrowej postawie przy biurku" FontSize="13" Foreground="#94A3B8" Margin="34,3,0,0" />
            </StackPanel>

            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="14,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⏳" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Kolejne przypomnienie za:" FontSize="11" Foreground="#94A3B8" />
                        <TextBlock x:Name="TimeRemainingText" Text="59 min 30 sek" FontSize="15" FontWeight="Bold" Foreground="#34D399" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" Padding="0,0,6,0">
            <StackPanel>
                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="⏱️ Częstotliwość przypomnień" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,2" />
                        <TextBlock Text="Wybierz, co ile minut ma pojawiać się okienko przypominające o wstaniu od biurka." FontSize="13" Foreground="#94A3B8" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Slider x:Name="IntervalSlider"
                                    Minimum="5" Maximum="180" SmallChange="5" LargeChange="15"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="60"
                                    ValueChanged="IntervalSlider_ValueChanged"
                                    VerticalAlignment="Center" Margin="0,0,16,0" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="IntervalValueText" Text="60" FontSize="20" FontWeight="Bold" Foreground="#10B981" />
                                <TextBlock Text=" min" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="2,0,0,2" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Szybki wybór:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="30 min" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0" Click="QuickInterval_Click" Tag="30"/>
                            <Button Content="45 min" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0" Click="QuickInterval_Click" Tag="45"/>
                            <Button Content="60 min (Domyślnie)" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0" Click="QuickInterval_Click" Tag="60"/>
                            <Button Content="90 min" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0" Click="QuickInterval_Click" Tag="90"/>
                            <Button Content="120 min" Style="{StaticResource SecondaryButton}" Padding="8,4" Click="QuickInterval_Click" Tag="120"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="💬 Treść powiadomienia" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,2" />
                        <TextBlock Text="Napisz własną treść wiadomości wyświetlanej podczas przypomnienia." FontSize="13" Foreground="#94A3B8" Margin="0,0,0,8" />

                        <TextBox x:Name="MessageTextBox"
                                 Style="{StaticResource ModernTextBox}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="65"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🎬 Filmik w tle przypomnienia" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,2" />
                        <TextBlock Text="Wybierz plik wideo (.mp4, .wmv, .webm itp.), który będzie odtwarzany w tle okna." FontSize="13" Foreground="#94A3B8" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="VideoPathTextBox"
                                     Style="{StaticResource ModernTextBox}"
                                     IsReadOnly="True"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center" />

                            <Button Grid.Column="1"
                                    Content="📂 Wybierz plik..."
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BrowseVideo_Click"
                                    Margin="0,0,8,0" />

                            <Button Grid.Column="2"
                                    Content="Usuń wideo"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ClearVideo_Click" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Height="115" Background="#090D16" CornerRadius="8" ClipToBounds="True" BorderBrush="#334155" BorderThickness="1">
                                <Grid>
                                    <MediaElement x:Name="PreviewMediaElement"
                                                  LoadedBehavior="Manual"
                                                  UnloadedBehavior="Manual"
                                                  Stretch="UniformToFill"
                                                  MediaEnded="PreviewMediaElement_MediaEnded"
                                                  Visibility="Collapsed" />
                                    <TextBlock x:Name="NoVideoPreviewText"
                                               Text="Brak wybranego wideo&#x0a;(użyte zostanie tło domyślne)"
                                               Foreground="#64748B" FontSize="11"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                <CheckBox x:Name="MuteVideoCheckBox"
                                          Content="Wycisz dźwięk z filmu"
                                          Foreground="#E2E8F0"
                                          FontSize="13"
                                          Margin="0,0,0,10"
                                          Checked="MuteVideoCheckBox_Changed"
                                          Unchecked="MuteVideoCheckBox_Changed" />

                                <TextBlock Text="Głośność filmu:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="VolumeSlider"
                                            Minimum="0" Maximum="100" Value="50"
                                            ValueChanged="VolumeSlider_ValueChanged"
                                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" x:Name="VolumeText" Text="50%" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="⚙️ Ustawienia systemowe" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,2" />

                        <CheckBox x:Name="AutoStartCheckBox"
                                  Foreground="#F8FAFC"
                                  FontSize="13"
                                  Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="Uruchamiaj aplikację automatycznie przy starcie Windows" FontWeight="Medium" />
                                <TextBlock Text="Aplikacja włączy się w tle w zasobniku systemowym po zalogowaniu." FontSize="12" Foreground="#94A3B8" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="▶ Przetestuj przypomnienie teraz"
                        Style="{StaticResource SecondaryButton}"
                        Click="TestReminder_Click" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Anuluj"
                            Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click"
                            Margin="0,0,10,0" />
                    <Button Content="💾 Zapisz ustawienia"
                            Style="{StaticResource PrimaryButton}"
                            Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
